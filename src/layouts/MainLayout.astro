---
import "../styles/global.css";
import SidebarProfile from "../components/SidebarProfile.astro";
import ScrollTop from "../components/ScrollTop.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_LAST_UPDATED, type SiteLang } from "../lib/site";
import { withBase } from "../lib/path";

type Props = {
  lang: SiteLang;
  currentPath: string;
  pageTitle: string;
  pageDescription?: string;
};

const { lang, currentPath, pageTitle, pageDescription } = Astro.props;
const normalizedPath = currentPath || "/";
const localizedPath = normalizedPath.replace(/^\/en(?=\/|$)/, "") || "/";
const zhPath = localizedPath;
const enPath = localizedPath === "/" ? "/en" : `/en${localizedPath}`;
const hasBanner = Astro.slots.has("banner");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription ?? "Academic personal website"} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg", import.meta.env.BASE_URL)} />
    <meta name="theme-color" content="#1d1b19" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var theme = stored || "dark";
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add("js");
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute("content", theme === "dark" ? "#1d1b19" : "#f5f4ef");
        }
      })();
    </script>
  </head>
  <body>
    <div class:list={["page-topbar", { "page-topbar--overlay": hasBanner }]}>
      <ThemeToggle lang={lang} />
      <div class="lang-switch-group">
        <a href={withBase(zhPath, import.meta.env.BASE_URL)} class:list={["lang-switch", { active: lang === "zh" }]}>
          {"中文"}
        </a>
        <a href={withBase(enPath, import.meta.env.BASE_URL)} class:list={["lang-switch", { active: lang === "en" }]}>EN</a>
      </div>
    </div>
    {hasBanner && <slot name="banner" />}
    <div class="site-shell" id="site-shell">
      <aside class="site-sidebar">
        <SidebarProfile lang={lang} currentPath={currentPath} />
      </aside>
      <main class="site-main">
        <div class="site-content">
          <slot />
        </div>
      </main>
    </div>
    <footer class="site-footer">
      <p>{lang === "zh" ? `更新时间：${SITE_LAST_UPDATED}` : `Last updated: ${SITE_LAST_UPDATED}`}</p>
    </footer>
    <ScrollTop lang={lang} />
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!("IntersectionObserver" in window)) return;
        var targets = document.querySelectorAll(".research-card, .pub-item, .writing-item");
        if (targets.length === 0) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach(function (el, i) {
          el.style.setProperty("--reveal-delay", (i % 4) * 60 + "ms");
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
